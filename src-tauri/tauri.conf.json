{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Costume LoRA Studio",
  "version": "0.2.0",
  "identifier": "studio.azuma.costume-lora",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "uv run --no-project scripts/make_icon.py",
    "beforeBuildCommand": "uv run --no-project scripts/make_icon.py"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Costume LoRA Studio",
        "width": 1280,
        "height": 880,
        "minWidth": 800,
        "minHeight": 640,
        "backgroundColor": "#10151b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../dataset_generator.py": "backend/dataset_generator.py",
      "../model_download.py": "backend/model_download.py",
      "../comfy_setup.py": "backend/comfy_setup.py",
      "../desktop_backend.py": "backend/desktop_backend.py"
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    }
  }
}
